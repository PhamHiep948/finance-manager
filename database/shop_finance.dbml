Project handmade_finance {
  database_type: "PostgreSQL"
  Note: '''
    Sản phẩm: HandmadeFinance. Schema shop_finance.
    Giao diện HTML mock; schema này bám đúng trường UI đang hiện.

    Người dùng: email đăng nhập, SĐT, avatar, vai trò, đang hoạt động / ngừng kích hoạt.
    Khoản thu: tên SP, mã đơn, khu vực EU, SL, đơn giá, Item/Discount/Subtotal/Ship/Tax,
    số tiền trước thuế (amount), % thuế, tiền sau thuế, kênh bán, trạng thái hồ sơ.
    Khoản chi: người nhận, nội địa/quốc tế, phương thức thanh toán, trước thuế / % thuế / sau thuế, trạng thái.
    Số tiền lưu USD. UI đổi EUR lúc xem — không tách data theo tiền tệ.
    Không quản lý kho SKU hay đơn nhiều dòng sản phẩm riêng.
    Loại thu seed: Bán hàng, Thu khác.
    Loại chi seed: Nguyên vật liệu, Bao bì / đóng gói, Vận chuyển, Quảng cáo,
    Phí dịch vụ, Lương nhân viên, Điện / nước / Internet, Thuê mặt bằng,
    Công cụ / thiết bị, Chi khác.
  '''
}

Enum user_role {
  ADMIN
  SHOP_OWNER
  EMPLOYEE
  VIEWER
}

Enum data_source {
  MANUAL
  EXCEL_IMPORT
}

Enum import_type {
  INCOME
  EXPENSE
}

Enum import_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum audit_action {
  INSERT
  UPDATE
  DELETE
  LOGIN
  EXPORT
  IMPORT
}

Enum sale_region {
  IN_EU
  OUTSIDE_EU
}

Enum origin_scope {
  DOMESTIC
  INTERNATIONAL
}

Enum sales_channel {
  ETSY_STORE
  WEBSITE_DIRECT
  INSTAGRAM_SHOP
  LOCAL_MARKET
  B2B_WHOLESALE
}

Enum payment_method {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  PAYPAL
}

Enum record_status {
  DRAFT
  PENDING
  COMPLETED
}

TableGroup users {
  app_users
}

TableGroup income {
  income_categories
  incomes
}

TableGroup expense {
  expense_categories
  expenses
}

TableGroup shared {
  import_batches
  attachments
  audit_logs
}

Table app_users [note: "Người dùng; 4 vai trò. UI: avatar, SĐT, trạng thái hoạt động, lần hoạt động gần nhất."] {
  id bigint [pk, increment]
  username varchar(100) [not null]
  email varchar(255)
  password_hash text [not null]
  full_name varchar(255) [not null]
  phone varchar(30)
  avatar_url text
  timezone varchar(64) [not null, default: "Asia/Ho_Chi_Minh"]
  role user_role [not null, default: "EMPLOYEE"]
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table import_batches [note: "Theo dõi từng lần import Excel trên trang Import dữ liệu Excel"] {
  id bigint [pk, increment]
  import_type import_type [not null]
  original_file_name varchar(500) [not null]
  stored_file_path text
  status import_status [not null, default: "PENDING"]
  total_rows integer [not null, default: 0]
  success_rows integer [not null, default: 0]
  failed_rows integer [not null, default: 0]
  error_details jsonb
  imported_by bigint
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
}

Table income_categories [note: "Phân loại khoản thu — UI badge Loại thu"] {
  id bigint [pk, increment]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  created_by bigint
}

Table incomes [note: "amount = số tiền trước thuế trên list/form. amount_after_tax tự tính từ % thuế. Chi tiết đơn: mã, EU, SL, phí. Modal chi tiết: kênh bán, trạng thái."] {
  id bigint [pk, increment]
  income_date date [not null]
  description text [not null]
  income_category_id bigint [not null]
  amount numeric(18,2) [not null]
  currency_code varchar(3) [not null, default: "USD", note: "V1 chỉ USD; EUR là đổi tiền trên UI"]
  reference_code varchar(150)
  order_code varchar(150)
  sale_region sale_region
  sales_channel sales_channel
  record_status record_status [not null, default: "COMPLETED"]
  product_qty integer
  unit_price numeric(18,2)
  item_total numeric(18,2)
  discount_amount numeric(18,2) [not null, default: 0]
  discount_code varchar(80)
  subtotal numeric(18,2)
  shipping_amount numeric(18,2) [not null, default: 0]
  tax_amount numeric(18,2) [not null, default: 0]
  tax_percent numeric(6,2) [not null, default: 0]
  amount_after_tax numeric(18,2) [not null, default: 0]
  source data_source [not null, default: "MANUAL"]
  import_batch_id bigint
  note text
  created_by bigint
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by bigint
}

Table expense_categories [note: "Phân loại khoản chi — UI badge Loại chi"] {
  id bigint [pk, increment]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  created_by bigint
}

Table expenses [note: "amount = số tiền trước thuế. Modal chi tiết: phương thức thanh toán, trạng thái hồ sơ."] {
  id bigint [pk, increment]
  expense_date date [not null]
  description text [not null]
  expense_category_id bigint [not null]
  amount numeric(18,2) [not null]
  currency_code varchar(3) [not null, default: "USD", note: "V1 chỉ USD; EUR là đổi tiền trên UI"]
  payee varchar(255)
  origin_scope origin_scope [not null, default: "DOMESTIC"]
  payment_method payment_method
  record_status record_status [not null, default: "COMPLETED"]
  tax_percent numeric(6,2) [not null, default: 0]
  amount_after_tax numeric(18,2) [not null]
  source data_source [not null, default: "MANUAL"]
  import_batch_id bigint
  note text
  created_by bigint
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by bigint
}

Table attachments [note: "Metadata chứng từ trên modal chi tiết; file ngoài Postgres. Đúng một trong income_id / expense_id"] {
  id bigint [pk, increment]
  income_id bigint
  expense_id bigint
  original_name varchar(500) [not null]
  storage_path text [not null]
  mime_type varchar(150)
  file_size_bytes bigint
  uploaded_by bigint
  uploaded_at timestamptz [not null, default: `now()`]
}

Table audit_logs [note: "Nhật ký hoạt động trên UI: module, mô tả, IP. Trigger INSERT/UPDATE/DELETE; LOGIN/EXPORT/IMPORT do app ghi."] {
  id bigint [pk, increment]
  table_name varchar(100)
  record_id bigint
  action audit_action [not null]
  module varchar(100)
  detail text
  actor_user_id bigint
  old_data jsonb
  new_data jsonb
  changed_at timestamptz [not null, default: `now()`]
  request_id uuid
  ip_address varchar
}

Ref: import_batches.imported_by > app_users.id [delete: set null]
Ref: income_categories.created_by > app_users.id [delete: set null]
Ref: incomes.income_category_id > income_categories.id
Ref: incomes.import_batch_id > import_batches.id [delete: set null]
Ref: incomes.created_by > app_users.id [delete: set null]
Ref: incomes.updated_by > app_users.id [delete: set null]
Ref: incomes.deleted_by > app_users.id [delete: set null]
Ref: expense_categories.created_by > app_users.id [delete: set null]
Ref: expenses.expense_category_id > expense_categories.id
Ref: expenses.import_batch_id > import_batches.id [delete: set null]
Ref: expenses.created_by > app_users.id [delete: set null]
Ref: expenses.updated_by > app_users.id [delete: set null]
Ref: expenses.deleted_by > app_users.id [delete: set null]
Ref: attachments.income_id > incomes.id [delete: cascade]
Ref: attachments.expense_id > expenses.id [delete: cascade]
Ref: attachments.uploaded_by > app_users.id [delete: set null]
Ref: audit_logs.actor_user_id > app_users.id [delete: set null]
