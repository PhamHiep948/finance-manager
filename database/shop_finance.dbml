Project handmade_finance {
  database_type: "PostgreSQL"
  Note: '''
    Web quản lý thu – chi Shop Handmade.
    Physical schema: shop_finance
    Database: handmade_finance
  '''
}

Enum user_role {
  ADMIN
  SHOP_OWNER
  EMPLOYEE
  VIEWER
}

Enum data_source {
  MANUAL
  EXCEL_IMPORT
}

Enum import_type {
  INCOME
  EXPENSE
}

Enum import_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum audit_action {
  INSERT
  UPDATE
  DELETE
}

TableGroup users {
  app_users
}

TableGroup income {
  income_categories
  incomes
  income_items
}

TableGroup expense {
  expense_categories
  expenses
}

TableGroup shared {
  import_batches
  attachments
  audit_logs
}

Table app_users [note: "Người dùng hệ thống; 4 vai trò, không có bảng permission riêng"] {
  id bigint [pk, increment]
  username varchar(100) [not null]
  email varchar(255)
  password_hash text [not null]
  full_name varchar(255) [not null]
  role user_role [not null, default: "EMPLOYEE"]
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: "Unique username/email khi chưa soft-delete"
}

Table import_batches [note: "Theo dõi từng lần import Excel"] {
  id bigint [pk, increment]
  import_type import_type [not null]
  original_file_name varchar(500) [not null]
  stored_file_path text
  status import_status [not null, default: "PENDING"]
  total_rows integer [not null, default: 0]
  success_rows integer [not null, default: 0]
  failed_rows integer [not null, default: 0]
  error_details jsonb
  imported_by bigint
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
}

Table income_categories [note: "Phân loại khoản thu cho báo cáo"] {
  id bigint [pk, increment]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  created_by bigint
}

Table incomes [note: "Header một đơn hàng / khoản thu"] {
  id bigint [pk, increment]
  income_category_id bigint [not null]
  order_date date [not null]
  customer_country varchar(100)
  product_quantity integer [not null, default: 0]
  item_total numeric(18,2) [not null, default: 0]
  discount_amount numeric(18,2) [not null, default: 0]
  subtotal numeric(18,2) [not null, default: 0]
  shipping_amount numeric(18,2) [not null, default: 0]
  tax_amount numeric(18,2) [not null, default: 0]
  order_total numeric(18,2) [not null]
  coupon_code varchar(100)
  currency_code varchar(3) [not null]
  source data_source [not null, default: "MANUAL"]
  import_batch_id bigint
  note text
  created_by bigint
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by bigint
}

Table income_items [note: "Dòng sản phẩm thuộc một khoản thu"] {
  id bigint [pk, increment]
  income_id bigint [not null]
  product_name varchar(500) [not null]
  external_transaction_id varchar(150)
  variant varchar(500)
  quantity integer [not null]
  unit_price numeric(18,2) [not null]
  line_total numeric(18,2) [not null, note: "GENERATED ALWAYS AS (quantity * unit_price) STORED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table expense_categories [note: "Phân loại khoản chi"] {
  id bigint [pk, increment]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  created_by bigint
}

Table expenses [note: "Khoản chi; xóa mềm bằng deleted_at"] {
  id bigint [pk, increment]
  expense_date date [not null]
  description text [not null]
  expense_category_id bigint [not null]
  amount numeric(18,2) [not null]
  currency_code varchar(3) [not null]
  payee varchar(255)
  note text
  source data_source [not null, default: "MANUAL"]
  import_batch_id bigint
  created_by bigint
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by bigint
}

Table attachments [note: "Metadata chứng từ; file nằm ngoài PostgreSQL. Đúng một trong income_id / expense_id"] {
  id bigint [pk, increment]
  income_id bigint
  expense_id bigint
  original_name varchar(500) [not null]
  storage_path text [not null]
  mime_type varchar(150)
  file_size_bytes bigint
  uploaded_by bigint
  uploaded_at timestamptz [not null, default: `now()`]
}

Table audit_logs [note: "Trigger ghi INSERT/UPDATE/DELETE; actor lấy từ SET LOCAL app.current_user_id"] {
  id bigint [pk, increment]
  table_name varchar(100) [not null]
  record_id bigint
  action audit_action [not null]
  actor_user_id bigint
  old_data jsonb
  new_data jsonb
  changed_at timestamptz [not null, default: `now()`]
  request_id uuid
  ip_address varchar
}

Ref: import_batches.imported_by > app_users.id [delete: set null]
Ref: income_categories.created_by > app_users.id [delete: set null]
Ref: incomes.income_category_id > income_categories.id
Ref: incomes.import_batch_id > import_batches.id [delete: set null]
Ref: incomes.created_by > app_users.id [delete: set null]
Ref: incomes.updated_by > app_users.id [delete: set null]
Ref: incomes.deleted_by > app_users.id [delete: set null]
Ref: income_items.income_id > incomes.id [delete: cascade]
Ref: expense_categories.created_by > app_users.id [delete: set null]
Ref: expenses.expense_category_id > expense_categories.id
Ref: expenses.import_batch_id > import_batches.id [delete: set null]
Ref: expenses.created_by > app_users.id [delete: set null]
Ref: expenses.updated_by > app_users.id [delete: set null]
Ref: expenses.deleted_by > app_users.id [delete: set null]
Ref: attachments.income_id > incomes.id [delete: cascade]
Ref: attachments.expense_id > expenses.id [delete: cascade]
Ref: attachments.uploaded_by > app_users.id [delete: set null]
Ref: audit_logs.actor_user_id > app_users.id [delete: set null]
