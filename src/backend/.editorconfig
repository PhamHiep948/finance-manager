root = true

[*.cs]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_require_accessibility_modifiers = always:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Public API values intentionally mirror the documented JSON contract.
dotnet_diagnostic.CA1707.severity = none
# This service is consumed by C# only; these names are part of the existing API vocabulary.
dotnet_diagnostic.CA1716.severity = none
# Repository overloads intentionally use domain-specific parameter names.
dotnet_diagnostic.CA1725.severity = none

[tests/**/*.cs]
# Existing test matrices use invariant ISO date literals.
dotnet_diagnostic.CA1305.severity = none
